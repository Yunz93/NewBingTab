{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "version": "1.0",
  "description": "__MSG_pluginDesc__",
  "icons": {
    "16": "src/icon16.png",
    "48": "src/icon48.png",
    "128": "src/icon128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": "src/icon16.png"
  },
  "default_locale": "zh_CN",
  "permissions": ["storage"],
  "host_permissions": ["https://cn.bing.com/*"],
  "chrome_url_overrides": {
    "newtab": "index.html"
  }
}
